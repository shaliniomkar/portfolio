---
/*
 * The island scene at the top of the home page: one inline SVG.
 *
 * Why one SVG? It scales like an image: every shape grows and shrinks
 * together, so the houses never drift off the grass at different screen
 * sizes. And because it's inline (not an <img>), CSS variables from
 * tokens.css can color it, and Phase 2 can make the buildings clickable.
 *
 * Coordinates use a 1440 × 620 "viewBox": a made-up grid that matches the
 * mockup at 1440 px wide. The browser scales that grid to the real size.
 * SVG draws in order, so later shapes sit on top of earlier ones.
 */
import Building from './Building.astro';
import Dog from './Dog.astro';
import DogToy from './DogToy.astro';
import { places, GROUND, signOffset } from '../data/places';

const W = 1440; // viewBox width
const H = 620;  // viewBox height
const pct = (n: number, total: number) => `${(n / total) * 100}%`;

/*
 * Clickable areas. SVG has no <button>, so each building gets a real HTML
 * <button> laid exactly over it. Because the SVG fills the .scene box and
 * keeps its shape, a position given in % of 1440 × 620 lands in the same
 * spot at every screen size. Real buttons come with keyboard support
 * (Tab to reach, Enter or Space to press) for free.
 */
const hitboxes = places.map((p) => {
  const half = p.kind === 'lighthouse' ? 48 : 102;   // half the building's width
  const top = GROUND + signOffset(p) - 22;           // just above the sign
  return {
    ...p,
    style: `left: ${pct(p.x - half, W)}; top: ${pct(top, H)}; width: ${pct(half * 2, W)}; height: ${pct(GROUND - top + 6, H)}`,
  };
});
---

<div class="scene-scroll">
 <div class="scene">
  <svg class="scene-art" viewBox="0 0 1440 620" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="island-title">
    <title id="island-title">
      A small pastel island with a Workshop, a Town Hall, a Record Shop and a Lookout lighthouse, and Cherry the dog
    </title>

    {/* 1. Sky fills everything; the rest is painted over it */}
    <rect class="sky" width="1440" height="620" />

    {/* 2. Clouds: each is two overlapping pill shapes (rects with big rounded corners) */}
    <g class="cloud cloud-left">
      <rect x="143" y="125" width="150" height="44" rx="22" />
      <rect x="188" y="106" width="140" height="36" rx="18" />
    </g>
    <g class="cloud cloud-right">
      <rect x="894" y="92" width="120" height="36" rx="18" />
      <rect x="928" y="80" width="110" height="28" rx="14" />
    </g>

    {/* 3. Sea, with one lighter wave line */}
    <rect class="sea" y="390" width="1440" height="230" />
    <rect class="sea-light" y="414" width="1440" height="6" />

    {/* 4. Island, back to front: sand, dark grass edge, grass.
           Each is a curved band. The top edge uses "C" (a cubic curve with
           two control points) so the island is flat and wide on top and
           only drops off near the edges: every building sits on grass.
           The bottom edge uses "Q" (one control point) for a simple bulge. */}
    <path class="sand" d="M0 476 C200 388 1240 388 1440 476 V540 Q720 612 0 540 Z" />
    <path class="grass-dark" d="M0 488 C200 400 1240 400 1440 488 V528 Q720 580 0 528 Z" />
    <path class="grass" d="M0 488 C200 400 1240 400 1440 488 V514 Q720 562 0 514 Z" />

    {/* 5. Sandy path from the front of the island */}
    <path class="path" d="M640 548 V490 Q640 455 698 455 Q756 455 756 490 V548 Z" />

    {/* 6. Trees: trunk, a darker circle for shade, then the canopy slightly up-left */}
    <g class="tree">
      <rect class="trunk" x="192" y="436" width="16" height="34" rx="6" />
      <circle class="canopy-dark" cx="204" cy="404" r="35" />
      <circle class="canopy" cx="198" cy="400" r="33" />
    </g>
    <g class="tree">
      <rect class="trunk" x="1133" y="440" width="14" height="30" rx="6" />
      <circle class="canopy-dark" cx="1142" cy="416" r="29" />
      <circle class="canopy" cx="1138" cy="412" r="27" />
    </g>

    {/* 7. Buildings: one component, drawn from the shared places list */}
    {places.map((p) => (
      <Building
        id={p.id}
        name={p.name}
        x={p.x}
        kind={p.kind}
        roof={p.roof}
        roofDark={p.roofDark}
        door={p.door}
        windows={p.windows}
        vinyl={p.vinyl}
        clock={p.clock}
      />
    ))}

    {/* 8. Cherry's toys, scattered on the grass in front of the buildings */}
    <DogToy kind="ball" x={330} y={490} />
    <DogToy kind="bone" x={480} y={490} rotate={-12} />
    <DogToy kind="rope" x={930} y={488} rotate={8} />
    <DogToy kind="ring" x={1060} y={482} />
    <DogToy kind="ball" x={1255} y={474} />

    {/* 9. A wooden signpost by the path, so visitors know Cherry talks.
           Two posts, then a board: a wood-colored rectangle with a cream
           one inside it, and the text on top. */}
    <g class="signpost" transform="translate(560 512)">
      <rect class="post" x="-66" y="-46" width="8" height="46" rx="3" />
      <rect class="post" x="58" y="-46" width="8" height="46" rx="3" />
      <rect class="board" x="-86" y="-66" width="172" height="34" rx="9" />
      <rect class="board-face" x="-81" y="-61" width="162" height="24" rx="6" />
      <text class="board-text" x="0" y="-44" text-anchor="middle">Click Cherry to chat!</text>
    </g>

  </svg>

  {/* Buttons laid over each building (see hitboxes above) */}
  {hitboxes.map((p) => (
    <button
      class="hit"
      type="button"
      data-place={p.id}
      aria-controls="bubble"
      aria-pressed="false"
      style={p.style}
    >
      <span class="visually-hidden">{p.name}</span>
    </button>
  ))}

  {/* Cherry is a button too. She lives outside the big SVG, in her own
      small one, so the button can travel with her as she trots. */}
  <button class="cherry" type="button" data-cherry aria-controls="bubble">
    <span class="visually-hidden">Cherry the dog. Click to hear what she thinks.</span>
    <svg viewBox="-31 -54 70 58" aria-hidden="true">
      <Dog walking />
    </svg>
  </button>
 </div>
</div>

<style>
  /*
   * On wide screens the scene simply fills the width.
   * On narrow screens it would get too tiny to read, so it keeps a minimum
   * width and this wrapper scrolls sideways instead. `overflow-x: auto`
   * keeps the scrolling inside this box, so the rest of the page never
   * gets wider than the screen.
   */
  .scene-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain; /* a sideways swipe here won't trigger "back" */
    background: var(--color-sky);
  }

  /* The box the art and buttons share. `position: relative` makes the
     buttons' % positions measure from this box's corners. */
  .scene {
    position: relative;
    min-width: 960px;
  }

  .scene-art {
    display: block; /* removes the small gap under inline elements */
    width: 100%;
    height: auto;
  }

  /* Invisible buttons over the buildings: no background or border,
     but a clear rounded focus ring when reached by keyboard. */
  .hit {
    position: absolute;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-lg);
    cursor: pointer;
  }

  .hit:focus-visible,
  .cherry:focus-visible {
    outline: 3px solid var(--color-link);
    outline-offset: 2px;
  }

  .sky { fill: var(--color-sky); }
  .cloud { fill: var(--color-cloud); }
  .sea { fill: var(--color-sea); }
  .sea-light { fill: var(--color-sea-light); }
  .sand { fill: var(--color-sand); }
  .grass-dark { fill: var(--color-grass-dark); }
  .grass { fill: var(--color-grass); }
  .path { fill: var(--color-path); }
  .trunk { fill: var(--color-wood); }
  .canopy-dark { fill: var(--color-tree-dark); }
  .canopy { fill: var(--color-tree); }
  .post { fill: var(--color-wood); }
  .board { fill: var(--color-wood); }
  .board-face { fill: var(--color-wall); }
  .board-text {
    fill: var(--color-text);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 15px;
  }

  /* Clouds drift slowly back and forth. People who turn on "reduce motion"
     in their system settings don't get the animation. */
  @media (prefers-reduced-motion: no-preference) {
    .cloud {
      animation: drift 14s ease-in-out infinite alternate;
    }
    .cloud-right {
      animation-duration: 18s;
    }
  }

  @keyframes drift {
    to { transform: translateX(40px); }
  }

  /*
   * Cherry's walk. Her button is positioned with left/top in % of the
   * scene (x / 1440 and y / 620 from the SVG grid), so she stays on the
   * grass at any size. translate(-50%, -100%) puts her feet, not her
   * top-left corner, on that point. The y values rise and fall a little to
   * follow the curve of the grass. At each end she pauses, then
   * scaleX(-1) mirrors her so she faces the way she walks.
   */
  .cherry {
    position: absolute;
    left: 40.97%;
    top: 85.16%;
    width: 5.35%;             /* 77 of 1440 scene units */
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transform: translate(-50%, -100%);
  }

  .cherry svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cherry {
      animation: trot 30s linear infinite;
    }
    /* Hovering or focusing her makes her stop and wait to be clicked.
       :global() reaches into Dog.astro to stop her legs too. */
    .cherry:is(:hover, :focus-visible),
    .cherry:is(:hover, :focus-visible) :global(.leg) {
      animation-play-state: paused;
    }
  }

  @keyframes trot {
    0%    { left: 19.44%; top: 83.23%; transform: translate(-50%, -100%) scaleX(1); }
    10%   { left: 34.72%; top: 84.84%; }
    22%   { left: 50.69%; top: 85.65%; }
    34%   { left: 66.67%; top: 84.84%; }
    44%   { left: 81.94%; top: 82.9%;  transform: translate(-50%, -100%) scaleX(1); }
    49.9% { left: 81.94%; top: 82.9%;  transform: translate(-50%, -100%) scaleX(1); }
    50%   { left: 81.94%; top: 82.9%;  transform: translate(-50%, -100%) scaleX(-1); }
    60%   { left: 66.67%; top: 84.84%; }
    72%   { left: 50.69%; top: 85.65%; }
    84%   { left: 34.72%; top: 84.84%; }
    94%   { left: 19.44%; top: 83.23%; transform: translate(-50%, -100%) scaleX(-1); }
    99.9% { left: 19.44%; top: 83.23%; transform: translate(-50%, -100%) scaleX(-1); }
    100%  { left: 19.44%; top: 83.23%; transform: translate(-50%, -100%) scaleX(1); }
  }
</style>
