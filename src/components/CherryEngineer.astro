---
/*
 * Cherry on the job: a small standalone SVG that reuses the Dog component
 * and adds props around her.
 *   tool="laptop": round glasses, typing away at a laptop
 *   tool="wrench": yellow hard hat, a wrench held in her mouth
 *   tool="mayor":  top hat and a sash with a gold medal (for the Town Hall)
 *   tool="dj":     headphones on, spinning a record on a turntable
 *
 * Dog draws Cherry around (0, 0) = her feet. The extra shapes below use
 * the same grid, so the hat lands on her head and the wrench in her mouth.
 */
import Dog from './Dog.astro';

interface Props {
  tool: 'laptop' | 'wrench' | 'mayor' | 'dj';
  label?: string; // for screen readers; leave out if it's just decoration
}

const { tool, label } = Astro.props;
// The visible area (the viewBox) is wider for the laptop, which sits beside her.
const viewBoxes = {
  laptop: '-34 -54 132 58', // wide: the laptop sits beside her
  dj: '-34 -54 132 58',     // wide: so does the turntable
  mayor: '-34 -66 86 70',   // tall: room for the top hat
  wrench: '-34 -56 86 60',
};
const viewBox = viewBoxes[tool];
---

<svg
  class="cherry-engineer"
  viewBox={viewBox}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {tool === 'laptop' && (
    <g class="laptop">
      {/* screen: dark frame, sky-blue display, a few colored "lines of code" */}
      <rect class="frame" x="46" y="-36" width="40" height="28" rx="3" />
      <rect class="display" x="49" y="-33" width="34" height="22" rx="1.5" />
      <rect class="code c1" x="52" y="-30" width="14" height="2.5" rx="1.25" />
      <rect class="code c2" x="55" y="-25.5" width="18" height="2.5" rx="1.25" />
      <rect class="code c3" x="55" y="-21" width="10" height="2.5" rx="1.25" />
      <rect class="code c1" x="52" y="-16.5" width="8" height="2.5" rx="1.25" />
      {/* blinking cursor */}
      <rect class="cursor" x="62" y="-16.5" width="2" height="2.5" />
      {/* base and keyboard */}
      <path class="base" d="M40 -8 H92 L96 -1 H36 Z" />
      <path class="keys" d="M46 -5 H86" />
    </g>
  )}

  {tool === 'dj' && (
    <g class="turntable">
      {/* the deck, seen from above: a wooden box with a record on it */}
      <rect class="deck" x="42" y="-40" width="50" height="40" rx="6" />
      <g class="record">
        <circle class="disc" cx="64" cy="-20" r="15" />
        <circle class="groove" cx="64" cy="-20" r="10.5" />
        {/* a white shine line, so you can see the record turning */}
        <path class="shine" d="M64 -33 A13 13 0 0 1 75 -27" />
        <circle class="label" cx="64" cy="-20" r="4.5" />
      </g>
      {/* tone arm resting on the record */}
      <path class="arm" d="M86 -34 L86 -18 L76 -12" />
      <circle class="knob" cx="86" cy="-34" r="2.5" />
      {/* little music notes floating up */}
      <g class="note note-1">
        <path d="M102 -34 v-10 l6 -2 v10" />
        <circle cx="100.5" cy="-34" r="2" />
        <circle cx="106.5" cy="-36" r="2" />
      </g>
      <g class="note note-2">
        <path d="M110 -22 v-9" />
        <circle cx="108.5" cy="-22" r="2" />
      </g>
    </g>
  )}

  {/* Everything Cherry-shaped goes in .body, which bobs gently */}
  <g class:list={['body', tool]}>
  <Dog />

  {tool === 'laptop' && (
    /* round glasses over her eye, with the arm running back to her ear */
    <g class="glasses nods">
      <circle cx="22" cy="-35" r="5" />
      <path d="M17 -35 L11 -36" />
    </g>
  )}

  {tool === 'wrench' && (
    <>
      {/* hard hat: a yellow dome with a brim */}
      <g class="hat nods">
        <path d="M8 -42 A11.5 10 0 0 1 31 -42 Z" />
        <rect x="5" y="-43.5" width="29" height="3.5" rx="1.75" />
        <rect class="hat-stripe" x="18" y="-51" width="3" height="8" rx="1.5" />
      </g>
      {/* wrench in her mouth: a handle and an open jaw at the end */}
      {/* the outer <g> nods with her head; the inner one places the wrench */}
      <g class="nods">
        <g class="wrench-tool" transform="translate(29 -26) rotate(-12)">
          <rect x="0" y="-1.8" width="17" height="3.6" rx="1.8" />
          <rect x="15" y="-5" width="3.5" height="10" rx="1.5" />
          <rect x="16" y="-5" width="7" height="3" rx="1.5" />
          <rect x="16" y="2" width="7" height="3" rx="1.5" />
        </g>
      </g>
    </>
  )}
  {tool === 'dj' && (
    /* headphones: a band over her head and a cushioned cup on her ear */
    <g class="headphones nods">
      <path class="band" d="M10 -37 Q11 -60 31 -49" />
      <rect class="cup" x="6" y="-38" width="10" height="13" rx="4.5" />
    </g>
  )}

  {tool === 'mayor' && (
    <>
      {/* sash: a coral band across her body, with a gold medal */}
      <g class="sash">
        <path d="M-12 -29 L-6 -29 L14 -9 L8 -9 Z" />
        <circle class="medal" cx="4" cy="-16" r="4" />
      </g>
      {/* top hat, tilted a little for style */}
      <g class="nods">
        <g class="top-hat" transform="rotate(-8 19 -45)">
          <rect class="brim" x="7" y="-47" width="25" height="3.5" rx="1.75" />
          <rect class="crown" x="11" y="-62" width="17" height="16" rx="2.5" />
          <rect class="band" x="11" y="-51" width="17" height="3.5" />
        </g>
      </g>
    </>
  )}
  </g>
</svg>

<style>
  .cherry-engineer {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .frame { fill: var(--color-text); }
  .display { fill: var(--color-sky); }
  .code.c1 { fill: var(--color-gallery); }
  .code.c2 { fill: var(--color-recordshop); }
  .code.c3 { fill: var(--color-lookout-dark); }
  .cursor { fill: var(--color-text); }
  .base {
    fill: var(--color-wall);
    stroke: var(--color-window-frame);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .keys {
    stroke: var(--color-window-frame);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 2 2;
  }

  .glasses {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .hat { fill: var(--color-accent); }
  .hat-stripe { fill: var(--color-star); }
  .wrench-tool { fill: var(--color-text-muted); }
  .sash path { fill: var(--color-recordshop); }
  .medal { fill: var(--color-accent); stroke: var(--color-star); stroke-width: 1.2; }
  .brim, .crown { fill: var(--color-vinyl); }
  .deck { fill: var(--color-wood); }
  .disc { fill: var(--color-vinyl); }
  .groove { fill: none; stroke: var(--color-text-muted); stroke-width: 0.8; }
  .shine { fill: none; stroke: var(--color-wall); stroke-width: 1.5; stroke-linecap: round; opacity: 0.8; }
  .label { fill: var(--color-recordshop); }
  .arm { fill: none; stroke: var(--color-wall); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .knob { fill: var(--color-wall); }
  .note path { fill: none; stroke: var(--color-gallery); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .note circle { fill: var(--color-gallery); }
  .band { fill: none; stroke: var(--color-recordshop-dark); stroke-width: 2.4; stroke-linecap: round; }
  .cup { fill: var(--color-recordshop); }

  /* The record spins around its own center (fill-box = its own box) */
  .record {
    transform-box: fill-box;
    transform-origin: center;
  }
  .band { fill: var(--color-recordshop); }

  /*
   * Little idle animations, so she isn't a still picture.
   * Her head, and anything on it (glasses, hat, wrench), share one
   * animation so they move together. They rotate around her neck, at
   * (12, -26) on the grid; `transform-box: view-box` makes that point
   * mean the SVG's grid rather than the shape's own box.
   * :global() reaches into Dog.astro's .head and .tail-wag groups.
   */
  .body :global(.head),
  .nods,
  .body :global(.tail-wag) {
    transform-box: view-box;
  }
  .body :global(.head),
  .nods {
    transform-origin: 12px -26px;
  }
  .body :global(.tail-wag) {
    transform-origin: -13px -24px; /* the base of her tail */
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1s steps(1) infinite;
    }

    /* Laptop: she nods along at the screen as she "types". */
    .laptop :global(.head),
    .laptop .nods {
      animation: nod 1.6s ease-in-out infinite;
    }

    /* Wrench: a proud little bounce, as if she just fixed something. */
    .body.wrench,
    .body.mayor {
      animation: hop 2.4s ease-in-out infinite;
    }
    .wrench :global(.head),
    .wrench .nods,
    .mayor :global(.head),
    .mayor .nods {
      animation: nod 2.4s ease-in-out infinite;
    }

    /* DJ: the record spins, she bobs her head to the beat, notes float up. */
    .record {
      animation: spin 1.8s linear infinite;
    }
    .dj :global(.head),
    .dj .nods {
      animation: nod 0.6s ease-in-out infinite;
    }
    .note-1 { animation: float 2s ease-in-out infinite; }
    .note-2 { animation: float 2s ease-in-out 1s infinite; }

    /* All of them: a happy tail wag. */
    .body :global(.tail-wag) {
      animation: wag 0.5s ease-in-out infinite alternate;
    }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
  @keyframes nod {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(6deg); }
  }
  @keyframes hop {
    0%, 60%, 100% { transform: translateY(0); }
    70% { transform: translateY(-4px); }
    80% { transform: translateY(0); }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes float {
    0% { transform: translateY(0); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateY(-8px); opacity: 0; }
  }
  @keyframes wag {
    from { transform: rotate(-10deg); }
    to { transform: rotate(10deg); }
  }
</style>
