---
/*
 * Cherry on the job: a small standalone SVG that reuses the Dog component
 * and adds props around her.
 *   tool="laptop": round glasses, typing away at a laptop
 *   tool="wrench": yellow hard hat, a wrench held in her mouth
 *
 * Dog draws Cherry around (0, 0) = her feet. The extra shapes below use
 * the same grid, so the hat lands on her head and the wrench in her mouth.
 */
import Dog from './Dog.astro';

interface Props {
  tool: 'laptop' | 'wrench';
  label?: string; // for screen readers; leave out if it's just decoration
}

const { tool, label } = Astro.props;
// The visible area (the viewBox) is wider for the laptop, which sits beside her.
const viewBox = tool === 'laptop' ? '-34 -54 132 58' : '-34 -56 86 60';
---

<svg
  class="cherry-engineer"
  viewBox={viewBox}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {tool === 'laptop' && (
    <g class="laptop">
      {/* screen: dark frame, sky-blue display, a few colored "lines of code" */}
      <rect class="frame" x="46" y="-36" width="40" height="28" rx="3" />
      <rect class="display" x="49" y="-33" width="34" height="22" rx="1.5" />
      <rect class="code c1" x="52" y="-30" width="14" height="2.5" rx="1.25" />
      <rect class="code c2" x="55" y="-25.5" width="18" height="2.5" rx="1.25" />
      <rect class="code c3" x="55" y="-21" width="10" height="2.5" rx="1.25" />
      <rect class="code c1" x="52" y="-16.5" width="8" height="2.5" rx="1.25" />
      {/* blinking cursor */}
      <rect class="cursor" x="62" y="-16.5" width="2" height="2.5" />
      {/* base and keyboard */}
      <path class="base" d="M40 -8 H92 L96 -1 H36 Z" />
      <path class="keys" d="M46 -5 H86" />
    </g>
  )}

  {/* Everything Cherry-shaped goes in .body, which bobs gently */}
  <g class:list={['body', tool]}>
  <Dog />

  {tool === 'laptop' && (
    /* round glasses over her eye, with the arm running back to her ear */
    <g class="glasses nods">
      <circle cx="22" cy="-35" r="5" />
      <path d="M17 -35 L11 -36" />
    </g>
  )}

  {tool === 'wrench' && (
    <>
      {/* hard hat: a yellow dome with a brim */}
      <g class="hat nods">
        <path d="M8 -42 A11.5 10 0 0 1 31 -42 Z" />
        <rect x="5" y="-43.5" width="29" height="3.5" rx="1.75" />
        <rect class="hat-stripe" x="18" y="-51" width="3" height="8" rx="1.5" />
      </g>
      {/* wrench in her mouth: a handle and an open jaw at the end */}
      {/* the outer <g> nods with her head; the inner one places the wrench */}
      <g class="nods">
        <g class="wrench-tool" transform="translate(29 -26) rotate(-12)">
          <rect x="0" y="-1.8" width="17" height="3.6" rx="1.8" />
          <rect x="15" y="-5" width="3.5" height="10" rx="1.5" />
          <rect x="16" y="-5" width="7" height="3" rx="1.5" />
          <rect x="16" y="2" width="7" height="3" rx="1.5" />
        </g>
      </g>
    </>
  )}
  </g>
</svg>

<style>
  .cherry-engineer {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .frame { fill: var(--color-text); }
  .display { fill: var(--color-sky); }
  .code.c1 { fill: var(--color-gallery); }
  .code.c2 { fill: var(--color-recordshop); }
  .code.c3 { fill: var(--color-lookout-dark); }
  .cursor { fill: var(--color-text); }
  .base {
    fill: var(--color-wall);
    stroke: var(--color-window-frame);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .keys {
    stroke: var(--color-window-frame);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 2 2;
  }

  .glasses {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .hat { fill: var(--color-accent); }
  .hat-stripe { fill: var(--color-star); }
  .wrench-tool { fill: var(--color-text-muted); }

  /*
   * Little idle animations, so she isn't a still picture.
   * Her head, and anything on it (glasses, hat, wrench), share one
   * animation so they move together. They rotate around her neck, at
   * (12, -26) on the grid; `transform-box: view-box` makes that point
   * mean the SVG's grid rather than the shape's own box.
   * :global() reaches into Dog.astro's .head and .tail-wag groups.
   */
  .body :global(.head),
  .nods,
  .body :global(.tail-wag) {
    transform-box: view-box;
  }
  .body :global(.head),
  .nods {
    transform-origin: 12px -26px;
  }
  .body :global(.tail-wag) {
    transform-origin: -13px -24px; /* the base of her tail */
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1s steps(1) infinite;
    }

    /* Laptop: she nods along at the screen as she "types". */
    .laptop :global(.head),
    .laptop .nods {
      animation: nod 1.6s ease-in-out infinite;
    }

    /* Wrench: a proud little bounce, as if she just fixed something. */
    .body.wrench {
      animation: hop 2.4s ease-in-out infinite;
    }
    .wrench :global(.head),
    .wrench .nods {
      animation: nod 2.4s ease-in-out infinite;
    }

    /* Both: a happy tail wag. */
    .body :global(.tail-wag) {
      animation: wag 0.5s ease-in-out infinite alternate;
    }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
  @keyframes nod {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(6deg); }
  }
  @keyframes hop {
    0%, 60%, 100% { transform: translateY(0); }
    70% { transform: translateY(-4px); }
    80% { transform: translateY(0); }
  }
  @keyframes wag {
    from { transform: rotate(-10deg); }
    to { transform: rotate(10deg); }
  }
</style>
