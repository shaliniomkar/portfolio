---
/*
 * Home page: header and island at the top, then the speech bubble and the
 * "Where to?" menu.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Island from '../components/Island.astro';
import SpeechBubble from '../components/SpeechBubble.astro';
import PlaceMenu from '../components/PlaceMenu.astro';
---

<BaseLayout title="Shalini's Island">
  {/* position: relative so the header can float over the island's sky */}
  <div class="hero">
    <SiteHeader overlay />
    <Island />
  </div>

  <main id="main">
    <SpeechBubble />
    <PlaceMenu />
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
  }

  main {
    padding: 0 var(--space-4);
  }
</style>
