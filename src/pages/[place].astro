---
/*
 * One placeholder page per place: /workshop/, /gallery/, /record-shop/,
 * /lookout/. The [place] in the file name is a parameter: getStaticPaths
 * tells Astro which values to build a page for. When a later phase adds a
 * real page (for example src/pages/workshop/index.astro), Astro uses that
 * one instead and this placeholder stops being used for it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Dog from '../components/Dog.astro';
import { places, type Place } from '../data/places';
import { url } from '../utils/url';

export function getStaticPaths() {
  // Places that already have their own real page are skipped here.
  const built = ['workshop', 'experience'];
  return places
    .filter((place) => !built.includes(place.id))
    .map((place) => ({ params: { place: place.id }, props: { place } }));
}

interface Props {
  place: Place;
}

const { place } = Astro.props;
---

<BaseLayout title={`${place.name} · Shalini's Island`} description={place.line}>
  <SiteHeader />
  <main class="soon">
    <svg class="cherry" viewBox="-31 -54 70 58" aria-hidden="true">
      <Dog />
    </svg>
    <h1>The {place.name} is still being built</h1>
    <p>{place.line}</p>
    <p class="quip">Cherry is guarding the door until it's ready.</p>
    <a class="pill pill-accent" href={url()}>Back to the island</a>
  </main>
</BaseLayout>

<style>
  .soon {
    max-width: 36rem;
    margin: var(--space-6) auto;
    padding: 0 var(--space-4);
    text-align: center;
  }

  .cherry {
    width: 7rem;
    height: auto;
    margin-bottom: var(--space-3);
  }

  .quip {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
</style>
