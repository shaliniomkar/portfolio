---
/*
 * The shell every page sits inside: <html>, <head>, fonts, styles, and the
 * footer. Pages pass in a title (and usually a description); the page's
 * own content goes where <slot /> is.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import { url } from '../utils/url';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Shalini's portfolio: a cozy island of projects, research, art and music.",
} = Astro.props;

// Full addresses (with https://...) for search engines and link previews.
// Astro.site comes from `site` in astro.config.mjs.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(url('og-image.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    {/* Tab icon: an SVG for modern browsers, a PNG for iPhones' home screen */}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    {/* Colors the browser bar on phones to match the sky */}
    <meta name="theme-color" content="#bfe6f2" />

    {/*
      Open Graph tags: what LinkedIn, iMessage, Discord, Slack etc. show
      when someone pastes a link to the site (title, blurb and a picture).
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shalini's Island" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A cozy pastel island with five little buildings and a fluffy white dog" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- preconnect opens the connection to Google Fonts early, so text appears sooner -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- display=swap shows a fallback font right away, then swaps in the real one -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Nunito:wght@400;600;700&display=swap"
    />
  </head>
  <body>
    <slot />
    <SiteFooter />
  </body>
</html>
